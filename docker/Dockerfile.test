ARG PYTHON_VERSION=39
FROM python:3.9-bullseye@sha256:5bd3c295ffab8b738108c7705052086d78b036078d5605dfc51e328ab758cc07 AS python39
FROM python:3.13-bookworm@sha256:073ffebb96ae4d0ed73ccad59f08c47bd84af8a79f5258130f8458ac50ad9ff4 AS python313

# Keep the native engine and compiler identical for both Python versions.
FROM python39 AS native
RUN python -m pip install --disable-pip-version-check --no-cache-dir cmake==3.25.2
WORKDIR /opt/lbry-rocksdb
COPY Makefile ./
COPY patches ./patches
COPY src/rocksdb ./src/rocksdb
ARG JOBS=2
RUN make JOBS="$JOBS"

FROM python${PYTHON_VERSION} AS wheel
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
COPY docker/test-requirements.txt /opt/test-requirements.txt
RUN python -m pip install --no-cache-dir -r /opt/test-requirements.txt
WORKDIR /opt/lbry-rocksdb
COPY --from=native /opt/lbry-rocksdb/src/rocksdb ./src/rocksdb
COPY setup.py setup.cfg pyproject.toml MANIFEST.in README.md LICENSE.md ./
COPY rocksdb ./rocksdb
RUN --network=none python -m pip wheel --no-index --no-build-isolation --no-deps --wheel-dir /unrepaired-wheels .

FROM python313 AS audit
COPY docker/audit-requirements.txt /opt/audit-requirements.txt
RUN python -m pip install --disable-pip-version-check --no-cache-dir -r /opt/audit-requirements.txt
COPY --from=wheel /unrepaired-wheels /unrepaired-wheels
ARG PYTHON_VERSION
RUN --network=none case "$PYTHON_VERSION" in \
        39) platform=manylinux_2_31_x86_64 ;; \
        313) platform=manylinux_2_35_x86_64 ;; \
        *) exit 1 ;; \
    esac \
    && auditwheel show /unrepaired-wheels/*.whl > /wheel-audit.txt \
    && auditwheel repair --plat "$platform" --only-plat --wheel-dir /wheels /unrepaired-wheels/*.whl \
    && auditwheel show /wheels/*.whl >> /wheel-audit.txt

FROM wheel AS test
COPY --from=audit /wheels /wheels
COPY --from=audit /wheel-audit.txt /wheel-audit.txt
RUN --network=none python -m pip install --no-index --no-deps /wheels/*.whl \
    && python -m pip check

# Run outside the checkout so imports exercise the installed wheel.
WORKDIR /opt/check
COPY tests ./tests
COPY scripts/test-wheel.sh ./test-wheel.sh
RUN useradd --create-home --uid 1000 tester \
    && mkdir /results \
    && chown -R tester:tester /results /opt/check
USER tester
ENV PYTHONUNBUFFERED=1
CMD ["timeout", "--signal=TERM", "--kill-after=30", "300", "sh", "./test-wheel.sh"]
